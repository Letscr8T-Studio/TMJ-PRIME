# All variables below are optional. With none set, contact form enquiries are
# logged to the server console instead of emailed (see src/lib/email.ts).

# Public production URL — used for canonical links, Open Graph/Twitter cards,
# sitemap.xml, and robots.txt. Safe to expose (NEXT_PUBLIC_*).
NEXT_PUBLIC_SITE_URL=https://www.tmjprime.co.uk

# Zoho Mail SMTP — used to send contact form enquiries. Required together for
# real delivery; if any are missing, enquiries are logged instead of emailed.
ZOHO_SMTP_HOST=smtppro.zoho.eu
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=sales@tmjprime.co.uk
ZOHO_SMTP_PASSWORD=your-app-specific-password-here

# Recipient/sender for enquiry emails.
CONTACT_TO_EMAIL=sales@tmjprime.co.uk
CONTACT_FROM_EMAIL=sales@tmjprime.co.uk
